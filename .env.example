# ==============================================================================
# Core AI Automation - Environment Variables Reference
# ==============================================================================

# Supabase Project Configuration
# Obtain these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Anti-Ban WhatsApp Settings (randomized wait between individual messages in seconds)
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=85

# Batch Cooldown Settings (randomized rest break in minutes after every batch)
BATCH_SIZE=5
BATCH_COOLDOWN_MIN_MINUTES=5
BATCH_COOLDOWN_MAX_MINUTES=10
BATCH_COOLDOWN_MINUTES=5
DAILY_SAFETY_LIMIT=25

# Anti-Ban Keystroke & Link Protection Modes
HUMAN_TYPING_MODE=true
SAFE_LINK_MODE=true

# Local Server Port
PORT=5000
